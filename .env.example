# =============================================================================
# KuliahPintar.id — Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN pernah commit file .env ke git!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
# Buat project di https://supabase.com lalu ambil dari: Project Settings > API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                          # public, aman di frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...                  # RAHASIA — hanya backend!

# -----------------------------------------------------------------------------
# GOOGLE GEMINI
# Buat API key di https://aistudio.google.com
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash                         # bisa diganti model lain

# -----------------------------------------------------------------------------
# MIDTRANS
# Dashboard: https://dashboard.midtrans.com
# Untuk development, gunakan akun Sandbox dulu
# -----------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-...                 # prefix SB- untuk sandbox
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_MODE=sandbox                                  # sandbox | production

# -----------------------------------------------------------------------------
# RESEND (Transactional Email)
# Daftar di https://resend.com, buat API key, dan verifikasi domain
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@kuliahpintar.id              # harus terverifikasi di Resend

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000                          # URL frontend
API_URL=http://localhost:3001                          # URL backend

# JWT secret tambahan (generate: openssl rand -base64 32)
JWT_SECRET=ganti-ini-dengan-string-acak-minimal-32-karakter

# -----------------------------------------------------------------------------
# NUXT / FRONTEND (prefix NUXT_PUBLIC_ untuk variabel yang aman di client)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
NUXT_PUBLIC_API_URL=http://localhost:3001
NUXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-...
NUXT_PUBLIC_APP_NAME=KuliahPintar.id
